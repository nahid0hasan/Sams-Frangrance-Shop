{%- liquid
  assign variant = section.settings.style_variant | default: 'editorial'
-%}

{% style %}
  #PageContent-{{ section.id }} {
    --pc-black: #1c1a17;
    --pc-white: #ffffff;
    --pc-grey: #fafafb;
    --pc-border: #e5e5e3;
    --pc-muted: #6b6b68;
    --pc-hover: #3a3734;
    --pc-font: 'Geist', 'Geist Sans', 'GeistVF', -apple-system, system-ui, sans-serif;

    {% if section.settings.color_scheme == 'white' %}
      --pc-bg: #ffffff;
      --pc-card: #fafafb;
    {% else %}
      --pc-bg: #fafafb;
      --pc-card: #ffffff;
    {% endif %}

    width: 100%;
    box-sizing: border-box;
    display: block;
    background-color: var(--pc-bg);
    color: var(--pc-black);
    font-family: var(--pc-font);

    padding-left: 20px;
    padding-right: 20px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #PageContent-{{ section.id }},
  #PageContent-{{ section.id }} * {
    font-family: var(--pc-font) !important;
  }

  #PageContent-{{ section.id }} .container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
  }

  #PageContent-{{ section.id }} .pc__inner {
    max-width: {{ section.settings.content_width }}px;
    width: 100%;
    margin: 0 {% if section.settings.alignment == 'center' %}auto{% else %}0{% endif %};
  }

  /* Page head */
  #PageContent-{{ section.id }} .pc__head {
    margin: 0 0 44px;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--pc-border);
  }

  #PageContent-{{ section.id }} .pc__eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pc-muted);
  }

  #PageContent-{{ section.id }} .pc__title {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, {{ section.settings.title_size | divided_by: 16.0 }}rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--pc-black);
  }

  #PageContent-{{ section.id }} .pc__lead {
    margin: 20px 0 0;
    font-size: clamp(1.125rem, 1.9vw, 1.375rem);
    line-height: 1.55;
    color: var(--pc-muted);
  }

  #PageContent-{{ section.id }} .pc__lead p {
    margin: 0;
    color: inherit;
    font-size: inherit;
  }

  /* Hero banner under the head */
  #PageContent-{{ section.id }} .pc__hero {
    position: relative;
    margin: 0 0 {{ section.settings.block_gap }}px;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--pc-card);
  }

  #PageContent-{{ section.id }} .pc__hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #PageContent-{{ section.id }} .pc__hero--16-9 { aspect-ratio: 16 / 9; }
  #PageContent-{{ section.id }} .pc__hero--3-2 { aspect-ratio: 3 / 2; }
  #PageContent-{{ section.id }} .pc__hero--21-9 { aspect-ratio: 21 / 9; }

  #PageContent-{{ section.id }} .pc__hero-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 34px 24px 18px;
    background: linear-gradient(to top, rgba(28, 26, 23, 0.78), rgba(28, 26, 23, 0));
    color: var(--pc-white);
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }

  /* Image block */
  #PageContent-{{ section.id }} .pc__figure {
    margin: 0;
  }

  #PageContent-{{ section.id }} .pc__figure-media {
    border-radius: 10px;
    overflow: hidden;
    background-color: var(--pc-card);
  }

  #PageContent-{{ section.id }} .pc__figure-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #PageContent-{{ section.id }} .pc__figure-media--16-9 { aspect-ratio: 16 / 9; }
  #PageContent-{{ section.id }} .pc__figure-media--3-2 { aspect-ratio: 3 / 2; }
  #PageContent-{{ section.id }} .pc__figure-media--1-1 { aspect-ratio: 1 / 1; }

  #PageContent-{{ section.id }} .pc__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background-color: var(--pc-card);
    fill: rgba(28, 26, 23, 0.14);
  }

  #PageContent-{{ section.id }} .pc__figure-cap {
    margin: 12px 0 0;
    padding-left: 14px;
    border-left: 2px solid var(--pc-border);
    font-size: 13px;
    line-height: 1.55;
    color: var(--pc-muted);
  }

  /* Image + text block */
  #PageContent-{{ section.id }} .pc__media-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
  }

  #PageContent-{{ section.id }} .pc__media-text--right .pc__media-text-media {
    order: 2;
  }

  #PageContent-{{ section.id }} .pc__media-text-media {
    border-radius: 10px;
    overflow: hidden;
    background-color: var(--pc-card);
    aspect-ratio: 4 / 3;
  }

  #PageContent-{{ section.id }} .pc__media-text-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #PageContent-{{ section.id }} .pc__media-text:hover .pc__media-text-media img {
    transform: scale(1.04);
  }

  #PageContent-{{ section.id }} .pc__media-text-title {
    margin: 0 0 12px;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--pc-black);
  }

  /* Shared block spacing */
  #PageContent-{{ section.id }} .pc__block {
    margin: 0 0 {{ section.settings.block_gap }}px;
  }

  #PageContent-{{ section.id }} .pc__block:last-child {
    margin-bottom: 0;
  }

  /* Heading */
  #PageContent-{{ section.id }} .pc__h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 1.875rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--pc-black);
  }

  #PageContent-{{ section.id }} .pc__h2-sub {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--pc-muted);
  }

  /* Rich text */
  #PageContent-{{ section.id }} .pc__rte {
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.75;
    color: #3a3734;
  }

  #PageContent-{{ section.id }} .pc__rte p {
    margin: 0 0 18px;
  }

  #PageContent-{{ section.id }} .pc__rte p:last-child {
    margin-bottom: 0;
  }

  #PageContent-{{ section.id }} .pc__rte strong {
    font-weight: 600;
    color: var(--pc-black);
  }

  #PageContent-{{ section.id }} .pc__rte a {
    color: var(--pc-black);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: opacity 0.22s ease;
  }

  #PageContent-{{ section.id }} .pc__rte a:hover {
    opacity: 0.7;
  }

  #PageContent-{{ section.id }} .pc__rte ul,
  #PageContent-{{ section.id }} .pc__rte ol {
    margin: 0 0 18px;
    padding-left: 22px;
  }

  #PageContent-{{ section.id }} .pc__rte li {
    margin-bottom: 8px;
  }

  /* Callout */
  #PageContent-{{ section.id }} .pc__callout {
    position: relative;
    padding: clamp(24px, 3.6vw, 40px);
    border-radius: 8px;
    overflow: hidden;
  }

  #PageContent-{{ section.id }} .pc__callout--dark {
    background-color: var(--pc-black);
    color: var(--pc-white);
  }

  #PageContent-{{ section.id }} .pc__callout--light {
    background-color: var(--pc-card);
    border: 1px solid var(--pc-border);
    color: var(--pc-black);
  }

  #PageContent-{{ section.id }} .pc__callout-mark {
    width: 34px;
    height: 34px;
    margin-bottom: 18px;
    opacity: 0.9;
  }

  #PageContent-{{ section.id }} .pc__callout-text {
    margin: 0;
    font-size: clamp(1.2rem, 2.3vw, 1.625rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  #PageContent-{{ section.id }} .pc__callout-text p {
    margin: 0;
  }

  #PageContent-{{ section.id }} .pc__callout-by {
    margin: 18px 0 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* Stats */
  #PageContent-{{ section.id }} .pc__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  #PageContent-{{ section.id }} .pc__stat {
    padding: 24px 20px;
    border: 1px solid var(--pc-border);
    border-radius: 8px;
    background-color: var(--pc-card);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  #PageContent-{{ section.id }} .pc__stat:hover {
    border-color: #d8d8d5;
    box-shadow: 0 12px 26px rgba(28, 26, 23, 0.08);
    transform: translateY(-3px);
  }

  #PageContent-{{ section.id }} .pc__stat-value {
    margin: 0;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--pc-black);
  }

  #PageContent-{{ section.id }} .pc__stat-label {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--pc-muted);
  }

  /* Points */
  #PageContent-{{ section.id }} .pc__points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  #PageContent-{{ section.id }} .pc__point {
    display: flex;
    gap: 16px;
    padding: 22px;
    border: 1px solid var(--pc-border);
    border-radius: 8px;
    background-color: var(--pc-card);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  #PageContent-{{ section.id }} .pc__point:hover {
    border-color: #d8d8d5;
    box-shadow: 0 12px 26px rgba(28, 26, 23, 0.08);
    transform: translateY(-3px);
  }

  #PageContent-{{ section.id }} .pc__point-num {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: var(--pc-black);
    color: var(--pc-white);
    font-size: 13px;
    font-weight: 600;
  }

  #PageContent-{{ section.id }} .pc__point-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--pc-black);
  }

  #PageContent-{{ section.id }} .pc__point-text {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--pc-muted);
  }

  /* Divider */
  #PageContent-{{ section.id }} .pc__divider {
    height: 1px;
    border: 0;
    margin: 0;
    background-color: var(--pc-border);
  }

  /* ---------------------------------------------------------
     Verified variant — a stricter, proof-led look for pages
     like the authenticity promise. Same markup, different skin.
     --------------------------------------------------------- */

  /* Eyebrow becomes a badge */
  #PageContent-{{ section.id }}.pc--verified .pc__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    padding: 7px 14px;
    border-radius: 999px;
    background-color: var(--pc-black);
    color: var(--pc-white);
    font-size: 11px;
    letter-spacing: 0.16em;
  }

  #PageContent-{{ section.id }}.pc--verified .pc__eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: currentColor;
  }

  /* Head sits on a rule instead of a plain border */
  #PageContent-{{ section.id }}.pc--verified .pc__head {
    border-bottom: 0;
    padding-bottom: 0;
  }

  #PageContent-{{ section.id }}.pc--verified .pc__lead {
    padding-left: 20px;
    border-left: 3px solid var(--pc-black);
    color: var(--pc-black);
  }

  /* Headings get an accent bar above */
  #PageContent-{{ section.id }}.pc--verified .pc__h2 {
    padding-top: 20px;
    border-top: 1px solid var(--pc-border);
  }

  #PageContent-{{ section.id }}.pc--verified .pc__h2::before {
    content: '';
    display: block;
    width: 44px;
    height: 3px;
    margin: -21px 0 18px;
    background-color: var(--pc-black);
  }

  /* Stats become one divided strip, no cards */
  #PageContent-{{ section.id }}.pc--verified .pc__stats {
    gap: 0;
    border: 1px solid var(--pc-border);
    border-radius: 10px;
    overflow: hidden;
    background-color: var(--pc-card);
  }

  #PageContent-{{ section.id }}.pc--verified .pc__stat {
    border: 0;
    border-radius: 0;
    background-color: transparent;
    text-align: left;
    padding: 26px 24px;
  }

  #PageContent-{{ section.id }}.pc--verified .pc__stat + .pc__stat {
    border-left: 1px solid var(--pc-border);
  }

  #PageContent-{{ section.id }}.pc--verified .pc__stat:hover {
    border-color: var(--pc-border);
    box-shadow: none;
    transform: none;
    background-color: var(--pc-bg);
  }

  /* Points become a checked list, not a card grid */
  #PageContent-{{ section.id }}.pc--verified .pc__points {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    border-top: 1px solid var(--pc-border);
  }

  #PageContent-{{ section.id }}.pc--verified .pc__point {
    align-items: flex-start;
    padding: 20px 4px;
    border: 0;
    border-bottom: 1px solid var(--pc-border);
    border-radius: 0;
    background-color: transparent;
  }

  #PageContent-{{ section.id }}.pc--verified .pc__point:hover {
    border-color: var(--pc-border);
    box-shadow: none;
    transform: none;
  }

  #PageContent-{{ section.id }}.pc--verified .pc__point:hover .pc__point-num {
    background-color: var(--pc-black);
    color: var(--pc-white);
  }

  #PageContent-{{ section.id }}.pc--verified .pc__point-num {
    width: 30px;
    height: 30px;
    margin-top: 2px;
    background-color: transparent;
    border: 1px solid var(--pc-black);
    color: var(--pc-black);
    transition: background-color 0.28s ease, color 0.28s ease;
  }

  #PageContent-{{ section.id }}.pc--verified .pc__point-num svg {
    width: 15px;
    height: 15px;
  }

  /* Callout reads as a stamped promise */
  #PageContent-{{ section.id }}.pc--verified .pc__callout {
    border-radius: 10px;
  }

  #PageContent-{{ section.id }}.pc--verified .pc__callout--dark {
    border: 1px solid var(--pc-black);
  }

  #PageContent-{{ section.id }}.pc--verified .pc__callout-mark {
    width: 40px;
    height: 40px;
    padding: 7px;
    border: 1px solid currentColor;
    border-radius: 50%;
    box-sizing: border-box;
    opacity: 1;
  }

  #PageContent-{{ section.id }}.pc--verified .pc__callout-text {
    font-weight: 600;
  }

  /* Buttons square off */
  #PageContent-{{ section.id }}.pc--verified .pc__btn {
    border-radius: 0;
  }

  #PageContent-{{ section.id }}.pc--verified .pc__hero,
  #PageContent-{{ section.id }}.pc--verified .pc__figure-media,
  #PageContent-{{ section.id }}.pc--verified .pc__media-text-media {
    border-radius: 2px;
    border: 1px solid var(--pc-border);
  }

  /* Buttons */
  #PageContent-{{ section.id }} .pc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  #PageContent-{{ section.id }} .pc__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 30px;
    border-radius: 3px;
    border: 1px solid var(--pc-black);
    background-color: var(--pc-black);
    color: var(--pc-white);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.28s ease, border-color 0.28s ease, transform 0.28s ease;
  }

  #PageContent-{{ section.id }} .pc__btn svg {
    width: 16px;
    height: 16px;
    transition: transform 0.28s ease;
  }

  #PageContent-{{ section.id }} .pc__btn:hover {
    background-color: var(--pc-hover);
    border-color: var(--pc-hover);
    transform: translateY(-1px);
  }

  #PageContent-{{ section.id }} .pc__btn:hover svg {
    transform: translateX(3px);
  }

  #PageContent-{{ section.id }} .pc__btn--ghost {
    background-color: transparent;
    color: var(--pc-black);
    border-color: var(--pc-border);
  }

  #PageContent-{{ section.id }} .pc__btn--ghost:hover {
    background-color: var(--pc-card);
    border-color: var(--pc-black);
  }

  #PageContent-{{ section.id }} .pc__btn:focus-visible {
    outline: 2px solid var(--pc-black);
    outline-offset: 3px;
  }

  /* Animation feel */
  #PageContent-{{ section.id }} .pc__reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.22, 0.61, 0.36, 1),
                transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #PageContent-{{ section.id }} .pc__reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    #PageContent-{{ section.id }} .pc__reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    #PageContent-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }

    #PageContent-{{ section.id }} .pc__head {
      margin-bottom: 32px;
      padding-bottom: 26px;
    }

    #PageContent-{{ section.id }} .pc__block {
      margin-bottom: {{ section.settings.block_gap | times: 0.75 | round }}px;
    }

    #PageContent-{{ section.id }} .pc__rte {
      font-size: {{ section.settings.text_size | minus: 1 }}px;
    }

    #PageContent-{{ section.id }} .pc__stats {
      grid-template-columns: minmax(0, 1fr);
    }

    #PageContent-{{ section.id }} .pc__points {
      grid-template-columns: minmax(0, 1fr);
    }

    #PageContent-{{ section.id }} .pc__media-text {
      grid-template-columns: minmax(0, 1fr);
    }

    #PageContent-{{ section.id }} .pc__media-text--right .pc__media-text-media {
      order: 0;
    }

    #PageContent-{{ section.id }} .pc__hero-cap {
      padding: 28px 16px 14px;
      font-size: 12px;
    }

    #PageContent-{{ section.id }}.pc--verified .pc__stat + .pc__stat {
      border-left: 0;
      border-top: 1px solid var(--pc-border);
    }

    #PageContent-{{ section.id }} .pc__btn {
      width: 100%;
    }
  }
{% endstyle %}

<section id="PageContent-{{ section.id }}" class="bytefied-page-content pc--{{ variant }}">
  <div class="container">
    <div class="pc__inner">
      {%- if section.settings.title != blank or section.settings.lead != blank -%}
        <header class="pc__head pc__reveal">
          {%- if section.settings.eyebrow != blank -%}
            <p class="pc__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h1 class="pc__title">{{ section.settings.title }}</h1>
          {%- endif -%}
          {%- if section.settings.lead != blank -%}
            <div class="pc__lead">{{ section.settings.lead }}</div>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if section.settings.head_image != blank -%}
        <div class="pc__hero pc__hero--{{ section.settings.head_image_ratio }} pc__reveal">
          {{
            section.settings.head_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 1200px) 1200px, 100vw',
              alt: section.settings.head_image.alt
          }}
          {%- if section.settings.head_image_caption != blank -%}
            <p class="pc__hero-cap">{{ section.settings.head_image_caption | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <div class="pc__block pc__reveal" {{ block.shopify_attributes }}>
              <h2 class="pc__h2">{{ b.heading }}</h2>
              {%- if b.subheading != blank -%}
                <p class="pc__h2-sub">{{ b.subheading | escape }}</p>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="pc__block pc__rte pc__reveal" {{ block.shopify_attributes }}>
              {{ b.text }}
            </div>

          {%- when 'callout' -%}
            <div class="pc__block pc__reveal" {{ block.shopify_attributes }}>
              <div class="pc__callout pc__callout--{{ b.style }}">
                <svg
                  class="pc__callout-mark"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 3.2l7 2.9v5.4c0 4.2-2.9 7.9-7 9.3-4.1-1.4-7-5.1-7-9.3V6.1l7-2.9z"/>
                  <path d="M8.9 12.1l2.1 2.1 4.1-4.2"/>
                </svg>
                <div class="pc__callout-text">{{ b.text }}</div>
                {%- if b.byline != blank -%}
                  <p class="pc__callout-by">{{ b.byline | escape }}</p>
                {%- endif -%}
              </div>
            </div>

          {%- when 'stats' -%}
            <div class="pc__block pc__reveal" {{ block.shopify_attributes }}>
              <div class="pc__stats">
                {%- for i in (1..3) -%}
                  {%- assign v_key = 'value_' | append: i -%}
                  {%- assign l_key = 'label_' | append: i -%}
                  {%- if b[v_key] != blank -%}
                    <div class="pc__stat">
                      <p class="pc__stat-value">{{ b[v_key] | escape }}</p>
                      {%- if b[l_key] != blank -%}
                        <p class="pc__stat-label">{{ b[l_key] | escape }}</p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

          {%- when 'points' -%}
            <div class="pc__block pc__reveal" {{ block.shopify_attributes }}>
              <div class="pc__points">
                {%- assign n = 0 -%}
                {%- for i in (1..4) -%}
                  {%- assign t_key = 'title_' | append: i -%}
                  {%- assign x_key = 'text_' | append: i -%}
                  {%- if b[t_key] != blank -%}
                    {%- assign n = n | plus: 1 -%}
                    <div class="pc__point">
                      <span class="pc__point-num">
                        {%- if variant == 'verified' -%}
                          <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M5.5 12.4l4.2 4.2 8.8-9"/>
                          </svg>
                        {%- else -%}
                          {{ n | prepend: '0' }}
                        {%- endif -%}
                      </span>
                      <div>
                        <p class="pc__point-title">{{ b[t_key] | escape }}</p>
                        {%- if b[x_key] != blank -%}
                          <p class="pc__point-text">{{ b[x_key] | escape }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

          {%- when 'image' -%}
            <div class="pc__block pc__reveal" {{ block.shopify_attributes }}>
              <figure class="pc__figure">
                <div class="pc__figure-media pc__figure-media--{{ b.ratio }}">
                  {%- if b.image != blank -%}
                    {{
                      b.image
                      | image_url: width: 1400
                      | image_tag:
                        loading: 'lazy',
                        widths: '420, 640, 860, 1100, 1400',
                        sizes: '(min-width: 1200px) 1100px, 100vw',
                        alt: b.image.alt
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'pc__placeholder' }}
                  {%- endif -%}
                </div>
                {%- if b.caption != blank -%}
                  <figcaption class="pc__figure-cap">{{ b.caption | escape }}</figcaption>
                {%- endif -%}
              </figure>
            </div>

          {%- when 'media_text' -%}
            <div class="pc__block pc__reveal" {{ block.shopify_attributes }}>
              <div class="pc__media-text pc__media-text--{{ b.image_position }}">
                <div class="pc__media-text-media">
                  {%- if b.image != blank -%}
                    {{
                      b.image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '320, 480, 640, 900',
                        sizes: '(min-width: 750px) 50vw, 100vw',
                        alt: b.image.alt
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'pc__placeholder' }}
                  {%- endif -%}
                </div>
                <div class="pc__media-text-body">
                  {%- if b.heading != blank -%}
                    <h2 class="pc__media-text-title">{{ b.heading }}</h2>
                  {%- endif -%}
                  {%- if b.text != blank -%}
                    <div class="pc__rte">{{ b.text }}</div>
                  {%- endif -%}
                </div>
              </div>
            </div>

          {%- when 'divider' -%}
            <div class="pc__block" {{ block.shopify_attributes }}>
              <hr class="pc__divider">
            </div>

          {%- when 'buttons' -%}
            <div class="pc__block pc__actions pc__reveal" {{ block.shopify_attributes }}>
              {%- if b.label_1 != blank -%}
                <a class="pc__btn" href="{{ b.link_1 | default: '#' }}">
                  <span>{{ b.label_1 | escape }}</span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 12h16M14 6l6 6-6 6"/>
                  </svg>
                </a>
              {%- endif -%}
              {%- if b.label_2 != blank -%}
                <a class="pc__btn pc__btn--ghost" href="{{ b.link_2 | default: '#' }}">
                  <span>{{ b.label_2 | escape }}</span>
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('PageContent-{{ section.id }}');
    if (!root) return;
    var items = root.querySelectorAll('.pc__reveal');

    if (!('IntersectionObserver' in window)) {
      items.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );

    items.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>

