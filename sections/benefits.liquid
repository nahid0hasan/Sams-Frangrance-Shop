{%- liquid
  assign scheme = section.settings.color_scheme
  assign icon_size = section.settings.icon_size
-%}

{% style %}
  #Benefits-{{ section.id }} {
    --bf-black: #1c1a17;
    --bf-white: #ffffff;
    --bf-grey: #f5f5f4;
    --bf-border: #e5e5e3;
    --bf-muted: #6b6b68;
    --bf-font: 'Geist', 'Geist Sans', 'GeistVF', -apple-system, system-ui, sans-serif;

    {% case scheme %}
      {% when 'dark' %}
        --bf-bg: #1c1a17;
        --bf-fg: #ffffff;
        --bf-soft: rgba(255, 255, 255, 0.72);
        --bf-line: rgba(255, 255, 255, 0.16);
        --bf-hover: rgba(255, 255, 255, 0.06);
      {% when 'grey' %}
        --bf-bg: #f5f5f4;
        --bf-fg: #1c1a17;
        --bf-soft: #6b6b68;
        --bf-line: #e5e5e3;
        --bf-hover: #ffffff;
      {% else %}
        --bf-bg: #ffffff;
        --bf-fg: #1c1a17;
        --bf-soft: #6b6b68;
        --bf-line: #e5e5e3;
        --bf-hover: #f5f5f4;
    {% endcase %}

    width: 100%;
    box-sizing: border-box;
    background-color: var(--bf-bg);
    color: var(--bf-fg);
    font-family: var(--bf-font);

    padding-left: 20px;
    padding-right: 20px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    {% if section.settings.show_top_border %}
      border-top: 1px solid var(--bf-line);
    {% endif %}
    {% if section.settings.show_bottom_border %}
      border-bottom: 1px solid var(--bf-line);
    {% endif %}
  }

  #Benefits-{{ section.id }},
  #Benefits-{{ section.id }} * {
    font-family: var(--bf-font) !important;
  }

  #Benefits-{{ section.id }} .container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding-left: 0;
    padding-right: 0;
  }

  #Benefits-{{ section.id }} .benefits__title {
    margin: 0 0 {{ section.settings.title_gap }}px;
    text-align: center;
    color: var(--bf-fg);
    font-size: clamp(1.375rem, 2.6vw, {{ section.settings.title_size | divided_by: 16.0 }}rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  #Benefits-{{ section.id }} .benefits__subtitle {
    margin: -8px 0 {{ section.settings.title_gap }}px;
    text-align: center;
    color: var(--bf-soft);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.5;
  }

  #Benefits-{{ section.id }} .benefits__subtitle p {
    margin: 0;
    color: inherit;
    font-size: inherit;
  }

  #Benefits-{{ section.id }} .benefits__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(28px, 5vw, 76px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #Benefits-{{ section.id }} .benefits__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
    max-width: 190px;
    padding: 12px 8px;
    border-radius: 3px;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  #Benefits-{{ section.id }} a.benefits__item:hover {
    background-color: var(--bf-hover);
    transform: translateY(-3px);
  }

  #Benefits-{{ section.id }} a.benefits__item:focus-visible {
    outline: 2px solid var(--bf-fg);
    outline-offset: 3px;
  }

  #Benefits-{{ section.id }} .benefits__icon {
    width: {{ icon_size }}px;
    height: {{ icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bf-fg);
  }

  #Benefits-{{ section.id }} .benefits__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #Benefits-{{ section.id }} .benefits__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #Benefits-{{ section.id }} .benefits__label {
    margin: 0;
    font-size: {{ section.settings.label_size }}px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bf-fg);
  }

  #Benefits-{{ section.id }} .benefits__note {
    margin: 0px 0 0;
    font-size: {{ section.settings.label_size | plus: 1 }}px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--bf-soft);
  }

  /* Animation feel */
  #Benefits-{{ section.id }} .benefits__reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.22, 0.61, 0.36, 1),
                transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #Benefits-{{ section.id }}.is-visible .benefits__reveal {
    opacity: 1;
    transform: translateY(0);
  }

  #Benefits-{{ section.id }}.is-visible .benefits__item:nth-child(1) { transition-delay: 0.05s; }
  #Benefits-{{ section.id }}.is-visible .benefits__item:nth-child(2) { transition-delay: 0.13s; }
  #Benefits-{{ section.id }}.is-visible .benefits__item:nth-child(3) { transition-delay: 0.21s; }
  #Benefits-{{ section.id }}.is-visible .benefits__item:nth-child(4) { transition-delay: 0.29s; }
  #Benefits-{{ section.id }}.is-visible .benefits__item:nth-child(5) { transition-delay: 0.37s; }
  #Benefits-{{ section.id }}.is-visible .benefits__item:nth-child(6) { transition-delay: 0.45s; }

  @media (prefers-reduced-motion: reduce) {
    #Benefits-{{ section.id }} .benefits__reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #Benefits-{{ section.id }} a.benefits__item:hover {
      transform: none;
    }
  }

  /* Tablet */
  @media screen and (max-width: 989px) {
    #Benefits-{{ section.id }} .benefits__grid {
      gap: 32px 24px;
    }

    #Benefits-{{ section.id }} .benefits__grid > li {
      flex: 0 0 calc(50% - 12px);
      max-width: calc(50% - 12px);
      box-sizing: border-box;
      display: flex;
      justify-content: center;
    }

    #Benefits-{{ section.id }} .benefits__item {
      width: 100%;
      max-width: 200px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    #Benefits-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }

    #Benefits-{{ section.id }} .benefits__grid {
      gap: 30px 0;
      justify-content: flex-start;
    }

    #Benefits-{{ section.id }} .benefits__grid > li {
      flex: 0 0 50%;
      width: 50%;
      max-width: 50%;
      box-sizing: border-box;
      display: flex;
      justify-content: center;
    }

    #Benefits-{{ section.id }} .benefits__item {
      width: 100%;
      max-width: none;
      gap: 12px;
      padding: 8px 10px;
      box-sizing: border-box;
    }

    #Benefits-{{ section.id }} .benefits__icon {
      width: {{ icon_size | times: 0.82 | round }}px;
      height: {{ icon_size | times: 0.82 | round }}px;
    }

    #Benefits-{{ section.id }} .benefits__label {
      font-size: {{ section.settings.label_size | minus: 1 }}px;
      letter-spacing: 0.08em;
    }
  }
{% endstyle %}

<section
  id="Benefits-{{ section.id }}"
  class="benefits"
  {% if section.settings.title != blank %}
    aria-label="{{ section.settings.title | strip_html | escape }}"
  {% endif %}
>
  <div class="container">
    {%- if section.settings.title != blank -%}
      <h2 class="benefits__title benefits__reveal">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <div class="benefits__subtitle benefits__reveal">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    <ul class="benefits__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <{{ tag }}
            class="benefits__item benefits__reveal"
            {% if tag == 'a' %}
              href="{{ block.settings.link }}"
            {% endif %}
          >
            <span class="benefits__icon" aria-hidden="true">
              {%- if block.settings.custom_icon != blank -%}
                {{
                  block.settings.custom_icon
                  | image_url: width: 160
                  | image_tag: loading: 'lazy', widths: '60, 90, 120, 160', alt: ''
                }}
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M12 3.2l7 2.9v5.4c0 4.2-2.9 7.9-7 9.3-4.1-1.4-7-5.1-7-9.3V6.1l7-2.9z"/>
                      <path d="M8.9 12.1l2.1 2.1 4.1-4.2"/>
                    </svg>
                  {%- when 'truck' -%}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M6.5 6.5h7.2v9.7H9.1"/>
                      <path d="M13.7 9.8h3.4l2.4 2.6v3.8h-2.3"/>
                      <circle cx="7.2" cy="17.4" r="1.7"/>
                      <circle cx="16" cy="17.4" r="1.7"/>
                      <path d="M2.4 8.6h2.6M1.4 11.4h3.6M2.4 14.2h2.6"/>
                    </svg>
                  {%- when 'box' -%}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M11.4 3.4L4 7v8.2l7.4 3.6 3-1.5"/>
                      <path d="M4 7l7.4 3.5L18.8 7l-7.4-3.6z"/>
                      <path d="M11.4 10.5v8.3"/>
                      <circle cx="17.4" cy="16.6" r="3.6"/>
                      <path d="M15.9 16.6l1.1 1.1 2-2.2"/>
                    </svg>
                  {%- when 'spray' -%}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="8.4" y="8.6" width="6.4" height="11.6" rx="1.6"/>
                      <path d="M10.2 8.6V6.2h2.8v2.4"/>
                      <path d="M13 4.6h2.3"/>
                      <path d="M17.2 3.2h.01M19 4.8h.01M17.4 6.6h.01M19.6 7.4h.01"/>
                    </svg>
                  {%- when 'vial' -%}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M9.4 3.4h5.2v3l-1 1v11.4a2.6 2.6 0 01-5.2 0V7.4l1-1z"/>
                      <path d="M8.4 12.4h7.2"/>
                    </svg>
                  {%- when 'star' -%}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M12 3.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.6 9.7l5.8-.8L12 3.6z"/>
                    </svg>
                  {%- when 'gift' -%}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="3.6" y="9.6" width="16.8" height="10.8" rx="1.4"/>
                      <path d="M3.6 13.4h16.8M12 9.6v10.8"/>
                      <path d="M12 9.6C9.8 9.6 7.6 9 7.6 7.1A2.1 2.1 0 0112 6.6a2.1 2.1 0 014.4.5c0 1.9-2.2 2.5-4.4 2.5z"/>
                    </svg>
                  {%- when 'lock' -%}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="4.8" y="10.2" width="14.4" height="9.8" rx="2"/>
                      <path d="M8.2 10.2V7.8a3.8 3.8 0 017.6 0v2.4"/>
                      <path d="M12 14v2.4"/>
                    </svg>
                  {%- when 'chat' -%}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4 5.6h16v10.2H9.8L4.6 19.8l.4-4H4z"/>
                      <path d="M8.4 10.7h7.2"/>
                    </svg>
                  {%- else -%}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="8.4"/>
                      <path d="M8.9 12.1l2.1 2.1 4.1-4.2"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </span>

            {%- if block.settings.label != blank -%}
              <p class="benefits__label">{{ block.settings.label | escape }}</p>
            {%- endif -%}

            {%- if block.settings.note != blank -%}
              <p class="benefits__note">{{ block.settings.note | escape }}</p>
            {%- endif -%}
          </{{ tag }}>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<script>
  (function () {
    var el = document.getElementById('Benefits-{{ section.id }}');
    if (!el) return;

    if (!('IntersectionObserver' in window)) {
      el.classList.add('is-visible');
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    observer.observe(el);
  })();
</script>

{% schema %}
{
  "name": "Benefits Bar",
  "tag": "section",
  "class": "benefits-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "The Sams Experience"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "info": "Optional line under the title."
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title max size",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_gap",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Space under the title",
      "default": 44
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Black background" },
        { "value": "white", "label": "White background" },
        { "value": "grey", "label": "Light grey background" }
      ],
      "default": "dark"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 46
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Label size",
      "default": 13
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield with check" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "box", "label": "Box with check" },
            { "value": "spray", "label": "Spray bottle" },
            { "value": "vial", "label": "Sample vial" },
            { "value": "star", "label": "Star" },
            { "value": "gift", "label": "Gift" },
            { "value": "lock", "label": "Secure lock" },
            { "value": "chat", "label": "Support chat" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Optional. Overrides the icon above. Use a transparent PNG or SVG."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "100% Authentic"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Small note",
          "info": "Optional second line in lighter text."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Makes the whole item clickable."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Bar",
      "category": "Bytefied",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "label": "100% Authentic",
            "note": "Batch code verified"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "truck",
            "label": "Ships In 2 Business Days",
            "note": "Tracked on every order"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "box",
            "label": "Free Shipping Over $125",
            "note": "Packed with care"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "vial",
            "label": "Samples From $6.99",
            "note": "Try before the full bottle"
          }
        }
      ]
    }
  ]
}
{% endschema %}
