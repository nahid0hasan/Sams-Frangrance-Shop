{%- liquid
  assign year = 'now' | date: '%Y'
  assign menu_blocks = section.blocks | where: 'type', 'menu'
-%}

{% style %}
  #BFooter-{{ section.id }} {
    --bf-black: #1c1a17;
    --bf-white: #ffffff;
    --bf-grey: #f5f5f4;
    --bf-border: rgba(255, 255, 255, 0.16);
    --bf-muted: rgba(255, 255, 255, 0.66);
    --bf-hover: rgba(255, 255, 255, 0.08);
    --bf-font: 'Geist', 'Geist Sans', 'GeistVF', -apple-system, system-ui, sans-serif;

    width: 100%;
    box-sizing: border-box;
    display: block;
    background-color: {{ section.settings.background }};
    color: var(--bf-white);
    font-family: var(--bf-font);

    padding-left: 20px;
    padding-right: 20px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #BFooter-{{ section.id }},
  #BFooter-{{ section.id }} * {
    font-family: var(--bf-font) !important;
  }

  #BFooter-{{ section.id }} .container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
  }

  /* Top grid */
  #BFooter-{{ section.id }} .bf__top {
    display: grid;
    grid-template-columns: minmax(280px, 1.5fr) repeat({{ menu_blocks.size | at_least: 1 }}, minmax(0, 1fr));
    gap: 48px 40px;
    align-items: start;
  }

  #BFooter-{{ section.id }} .bf__logo {
    display: inline-block;
    margin-bottom: 18px;
  }

  #BFooter-{{ section.id }} .bf__logo img {
    display: block;
    width: auto;
    height: auto;
    max-width: {{ section.settings.logo_width }}px;
  }

  #BFooter-{{ section.id }} .bf__wordmark {
    margin: 0 0 18px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--bf-white);
  }

  #BFooter-{{ section.id }} .bf__about {
    margin: 0 0 26px;
    max-width: 42ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--bf-muted);
  }

  #BFooter-{{ section.id }} .bf__about p {
    margin: 0;
    color: inherit;
    font-size: inherit;
  }

  /* Socials */
  #BFooter-{{ section.id }} .bf__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 30px;
    padding: 0;
    list-style: none;
  }

  #BFooter-{{ section.id }} .bf__social {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--bf-border);
    border-radius: 50%;
    color: var(--bf-white);
    transition: background-color 0.26s ease, border-color 0.26s ease, transform 0.26s ease;
  }

  #BFooter-{{ section.id }} .bf__social svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  #BFooter-{{ section.id }} .bf__social:hover {
    background-color: var(--bf-white);
    border-color: var(--bf-white);
    color: {{ section.settings.background }};
    transform: translateY(-2px);
  }

  /* Newsletter */
  #BFooter-{{ section.id }} .bf__news-title {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--bf-white);
  }

  #BFooter-{{ section.id }} .bf__news-text {
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--bf-muted);
  }

  #BFooter-{{ section.id }} .bf__form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 420px;
  }

  #BFooter-{{ section.id }} .bf__input {
    flex: 1 1 200px;
    min-height: 48px;
    padding: 0 16px;
    border-radius: 2px;
    border: 1px solid var(--bf-border);
    background-color: rgba(255, 255, 255, 0.04);
    color: var(--bf-white);
    font-size: 15px;
    box-sizing: border-box;
    transition: border-color 0.26s ease, background-color 0.26s ease;
  }

  #BFooter-{{ section.id }} .bf__input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  #BFooter-{{ section.id }} .bf__input:focus {
    outline: none;
    border-color: var(--bf-white);
    background-color: rgba(255, 255, 255, 0.08);
  }

  #BFooter-{{ section.id }} .bf__submit {
    flex: 0 0 auto;
    min-height: 48px;
    padding: 0 26px;
    border-radius: 2px;
    border: 1px solid var(--bf-white);
    background-color: var(--bf-white);
    color: {{ section.settings.background }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.26s ease, border-color 0.26s ease, transform 0.26s ease;
  }

  #BFooter-{{ section.id }} .bf__submit:hover {
    background-color: var(--bf-grey);
    border-color: var(--bf-grey);
    transform: translateY(-1px);
  }

  #BFooter-{{ section.id }} .bf__form-note {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--bf-muted);
  }

  /* Menu columns */
  #BFooter-{{ section.id }} .bf__col-title {
    margin: 0 0 18px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.3;
    color: var(--bf-white);
  }

  #BFooter-{{ section.id }} .bf__links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  #BFooter-{{ section.id }} .bf__link {
    font-size: 15px;
    line-height: 1.45;
    color: var(--bf-muted);
    text-decoration: none;
    transition: color 0.22s ease, padding-left 0.22s ease;
  }

  #BFooter-{{ section.id }} .bf__link:hover {
    color: var(--bf-white);
    padding-left: 5px;
  }

  #BFooter-{{ section.id }} .bf__text-block {
    font-size: 15px;
    line-height: 1.6;
    color: var(--bf-muted);
  }

  #BFooter-{{ section.id }} .bf__text-block p {
    margin: 0 0 10px;
    color: inherit;
    font-size: inherit;
  }

  #BFooter-{{ section.id }} .bf__text-block p:last-child {
    margin-bottom: 0;
  }

  #BFooter-{{ section.id }} .bf__text-block a {
    color: var(--bf-white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* App badges */
  #BFooter-{{ section.id }} .bf__apps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 22px;
  }

  #BFooter-{{ section.id }} .bf__app img {
    display: block;
    width: auto;
    height: {{ section.settings.badge_height }}px;
    border-radius: 4px;
    transition: opacity 0.26s ease, transform 0.26s ease;
  }

  #BFooter-{{ section.id }} .bf__app:hover img {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  /* Bottom bar */
  #BFooter-{{ section.id }} .bf__bottom {
    margin-top: {{ section.settings.bottom_gap }}px;
    padding-top: 26px;
    border-top: 1px solid var(--bf-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  #BFooter-{{ section.id }} .bf__pay {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 100%;
  }

  #BFooter-{{ section.id }} .bf__pay-img {
    display: block;
    width: auto;
    max-width: 100%;
    height: {{ section.settings.payment_height }}px;
    object-fit: contain;
  }

  #BFooter-{{ section.id }} .bf__pay-icon {
    display: block;
    width: auto;
    height: {{ section.settings.payment_height }}px;
  }

  #BFooter-{{ section.id }} .bf__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    font-size: 14px;
    color: var(--bf-muted);
  }

  #BFooter-{{ section.id }} .bf__legal a {
    color: var(--bf-muted);
    text-decoration: none;
    transition: color 0.22s ease;
  }

  #BFooter-{{ section.id }} .bf__legal a:hover {
    color: var(--bf-white);
  }

  #BFooter-{{ section.id }} .bf__top-btn {
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--bf-border);
    border-radius: 50%;
    background: none;
    color: var(--bf-white);
    cursor: pointer;
    transition: background-color 0.26s ease, border-color 0.26s ease, transform 0.26s ease;
  }

  #BFooter-{{ section.id }} .bf__top-btn svg {
    width: 16px;
    height: 16px;
  }

  #BFooter-{{ section.id }} .bf__top-btn:hover {
    background-color: var(--bf-white);
    border-color: var(--bf-white);
    color: {{ section.settings.background }};
    transform: translateY(-2px);
  }

  #BFooter-{{ section.id }} a:focus-visible,
  #BFooter-{{ section.id }} button:focus-visible,
  #BFooter-{{ section.id }} input:focus-visible {
    outline: 2px solid var(--bf-white);
    outline-offset: 3px;
  }

  /* Animation feel */
  #BFooter-{{ section.id }} .bf__reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s cubic-bezier(0.22, 0.61, 0.36, 1),
                transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  #BFooter-{{ section.id }}.is-visible .bf__reveal {
    opacity: 1;
    transform: translateY(0);
  }

  #BFooter-{{ section.id }}.is-visible .bf__reveal--2 { transition-delay: 0.08s; }
  #BFooter-{{ section.id }}.is-visible .bf__reveal--3 { transition-delay: 0.14s; }

  @media (prefers-reduced-motion: reduce) {
    #BFooter-{{ section.id }} .bf__reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Tablet */
  @media screen and (max-width: 1099px) {
    #BFooter-{{ section.id }} .bf__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 32px;
    }

    #BFooter-{{ section.id }} .bf__brand {
      grid-column: 1 / -1;
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    #BFooter-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }

    #BFooter-{{ section.id }} .bf__top {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    #BFooter-{{ section.id }} .bf__about {
      max-width: 100%;
    }

    #BFooter-{{ section.id }} .bf__form {
      max-width: 100%;
    }

    #BFooter-{{ section.id }} .bf__submit {
      width: 100%;
    }

    #BFooter-{{ section.id }} .bf__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
    }

    #BFooter-{{ section.id }} .bf__legal {
      gap: 14px;
      font-size: 13px;
    }

    #BFooter-{{ section.id }} .bf__pay {
      width: 100%;
      justify-content: flex-start;
    }

    #BFooter-{{ section.id }} .bf__pay-img,
    #BFooter-{{ section.id }} .bf__pay-icon {
      height: {{ section.settings.payment_height_mobile }}px;
    }

    #BFooter-{{ section.id }} .bf__top-btn {
      align-self: flex-end;
      margin-top: -52px;
    }
  }
{% endstyle %}

<section id="BFooter-{{ section.id }}" class="bytefied-footer" role="contentinfo">
  <div class="container">
    <div class="bf__top">
      <div class="bf__brand bf__reveal">
        {%- if section.settings.logo != blank -%}
          <a class="bf__logo" href="{{ routes.root_url }}">
            {{
              section.settings.logo
              | image_url: width: 600
              | image_tag: loading: 'lazy', widths: '120, 180, 240, 360, 480, 600', sizes: section.settings.logo_width
            -}}
            px', alt: shop.name | escape }}
          </a>
        {%- elsif section.settings.wordmark != blank -%}
          <p class="bf__wordmark">{{ section.settings.wordmark }}</p>
        {%- endif -%}

        {%- if section.settings.about != blank -%}
          <div class="bf__about">{{ section.settings.about }}</div>
        {%- endif -%}

        {%- assign has_social = false -%}
        {%- if section.settings.instagram != blank
          or section.settings.tiktok != blank
          or section.settings.facebook != blank
          or section.settings.youtube != blank
          or section.settings.pinterest != blank
          or section.settings.x_link != blank
        -%}
          {%- assign has_social = true -%}
        {%- endif -%}

        {%- if has_social -%}
          <ul class="bf__socials" role="list">
            {%- if section.settings.instagram != blank -%}
              <li>
                <a
                  class="bf__social"
                  href="{{ section.settings.instagram }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Instagram"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.3-.1 1.7-.1 4.9-.1zm0 3.4a6.4 6.4 0 100 12.8 6.4 6.4 0 000-12.8zm0 2.2a4.2 4.2 0 110 8.4 4.2 4.2 0 010-8.4zm6.7-2.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}

            {%- if section.settings.tiktok != blank -%}
              <li>
                <a
                  class="bf__social"
                  href="{{ section.settings.tiktok }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="TikTok"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16.3 2.5c.4 2.3 1.7 3.7 3.9 3.9v2.5c-1.4.1-2.7-.3-4-1.1v5.9c0 5-4.1 7.7-8 6.1-2.5-1.1-3.7-4.1-2.9-6.8.7-2.5 3.1-4.1 5.9-3.8v2.6c-.4.1-.8.1-1.2.3-1.2.4-1.9 1.6-1.7 2.8.2 1.2 1.3 2.1 2.6 2 1.4 0 2.5-1.1 2.5-2.5V2.5h2.9z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}

            {%- if section.settings.facebook != blank -%}
              <li>
                <a
                  class="bf__social"
                  href="{{ section.settings.facebook }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Facebook"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.3H7.6V13h2.8v8h3.1z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}

            {%- if section.settings.youtube != blank -%}
              <li>
                <a
                  class="bf__social"
                  href="{{ section.settings.youtube }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="YouTube"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21.6 7.2c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15.1V8.9l5.2 3.1-5.2 3.1z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}

            {%- if section.settings.x_link != blank -%}
              <li>
                <a
                  class="bf__social"
                  href="{{ section.settings.x_link }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="X"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M17.5 3h3l-6.6 7.5L21.8 21h-6l-4.7-6.1L5.7 21h-3l7-8L2.5 3h6.2l4.2 5.6L17.5 3zm-1.1 16.2h1.7L7.7 4.7H5.9l10.5 14.5z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}

            {%- if section.settings.pinterest != blank -%}
              <li>
                <a
                  class="bf__social"
                  href="{{ section.settings.pinterest }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Pinterest"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.5a9.5 9.5 0 00-3.5 18.3c-.1-.8-.1-2 .1-2.8l1.1-4.8s-.3-.6-.3-1.4c0-1.3.8-2.3 1.7-2.3.8 0 1.2.6 1.2 1.4 0 .8-.5 2.1-.8 3.3-.2.9.5 1.7 1.4 1.7 1.7 0 2.9-2.2 2.9-4.7 0-2-1.3-3.4-3.7-3.4-2.7 0-4.3 2-4.3 4.1 0 .8.3 1.6.6 2.1.1.1.1.2.1.3l-.2.9c0 .2-.2.2-.3.1-1.1-.5-1.8-2.1-1.8-3.4 0-2.8 2-5.3 5.9-5.3 3.1 0 5.5 2.2 5.5 5.1 0 3.1-1.9 5.6-4.7 5.6-.9 0-1.8-.5-2.1-1.1l-.6 2.2c-.2.8-.8 1.9-1.2 2.5A9.5 9.5 0 1012 2.5z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          <div class="bf__news">
            {%- if section.settings.news_title != blank -%}
              <p class="bf__news-title">{{ section.settings.news_title | escape }}</p>
            {%- endif -%}
            {%- if section.settings.news_text != blank -%}
              <p class="bf__news-text">{{ section.settings.news_text | escape }}</p>
            {%- endif -%}

            {%- form 'customer', class: 'bf__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="BFooterEmail-{{ section.id }}">Email</label>
              <input
                id="BFooterEmail-{{ section.id }}"
                class="bf__input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.news_placeholder | escape }}"
                autocomplete="email"
                required
              >
              <button class="bf__submit" type="submit">{{ section.settings.news_button | escape }}</button>

              {%- if form.errors -%}
                <p class="bf__form-note">
                  {{ form.errors.translated_fields.email }}
                  {{ form.errors.messages.email }}
                </p>
              {%- elsif form.posted_successfully? -%}
                <p class="bf__form-note">Thanks for signing up. Watch your inbox for the next drop.</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}

        {%- if section.settings.app_store_image != blank or section.settings.play_store_image != blank -%}
          <div class="bf__apps">
            {%- if section.settings.app_store_image != blank -%}
              <a
                class="bf__app"
                href="{{ section.settings.app_store_link | default: '#' }}"
                target="_blank"
                rel="noopener"
              >
                {{
                  section.settings.app_store_image
                  | image_url: height: 160
                  | image_tag: loading: 'lazy', alt: 'Download on the App Store'
                }}
              </a>
            {%- endif -%}
            {%- if section.settings.play_store_image != blank -%}
              <a
                class="bf__app"
                href="{{ section.settings.play_store_link | default: '#' }}"
                target="_blank"
                rel="noopener"
              >
                {{
                  section.settings.play_store_image
                  | image_url: height: 160
                  | image_tag: loading: 'lazy', alt: 'Get it on Google Play'
                }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="bf__col bf__reveal bf__reveal--2" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="bf__col-title">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="bf__links" role="list">
                  {%- for link in linklists[block.settings.menu].links -%}
                    <li>
                      <a class="bf__link" href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="bf__col bf__reveal bf__reveal--3" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="bf__col-title">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="bf__text-block">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="bf__bottom bf__reveal bf__reveal--3">
      <div class="bf__legal">
        <span>&copy; {{ year }}, {{ shop.name }}</span>
        {%- if section.settings.legal_menu != blank -%}
          {%- for link in linklists[section.settings.legal_menu].links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}

        {%- if section.settings.show_back_to_top -%}
          <button type="button" class="bf__top-btn" data-bf-top aria-label="Back to top">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 19V5"/>
              <path d="M5.5 11.5L12 5l6.5 6.5"/>
            </svg>
          </button>
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_icons -%}
        <div class="bf__pay">
          {%- if section.settings.payment_image != blank -%}
            {{
              section.settings.payment_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200',
                class: 'bf__pay-img',
                alt: 'Accepted payment methods'
            }}
          {%- else -%}
            <span class="visually-hidden">Accepted payment methods</span>
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'bf__pay-icon' }}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('BFooter-{{ section.id }}');
    if (!root) return;

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.05 }
      );
      io.observe(root);
    } else {
      root.classList.add('is-visible');
    }

    var topBtn = root.querySelector('[data-bf-top]');
    if (topBtn) {
      topBtn.addEventListener('click', function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    }
  })();
</script>

