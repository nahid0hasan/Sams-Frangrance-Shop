    "bytefied_faq_PWNzKa": {
      "type": "bytefied-faq",
      "blocks": {
        "faq_G7ME7L": {
          "type": "faq",
          "settings": {
            "question": "Are your fragrances authentic?",
            "answer": "<p>Yes. Every bottle is sourced from authorized distributors and verified by batch code before it leaves our shelf. If you ever want the batch details for an order, message us and we will send them over.</p>"
          }
        },
        "faq_6mphrQ": {
          "type": "faq",
          "settings": {
            "question": "Why are your prices lower than retail?",
            "answer": "<p>We buy at wholesale and keep our margins thin instead of paying for department store counters and heavy advertising. Same bottle, same juice, smaller price tag.</p>"
          }
        },
        "faq_KfhXX8": {
          "type": "faq",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders leave our shop within two business days and most parcels land in two to four days after that. Orders over $125 ship free and every order comes with tracking.</p>"
          }
        },
        "faq_tnczdW": {
          "type": "faq",
          "settings": {
            "question": "What exactly is a sample or decant?",
            "answer": "<p>It is a small spray vial filled from the original bottle, so you get the real fragrance in a size you can carry and test for a week. Samples start at $6.99 and it is the cheapest way to find out if a scent suits you.</p>"
          }
        },
        "faq_XKfgVB": {
          "type": "faq",
          "settings": {
            "question": "I am new to fragrances. Where should I start?",
            "answer": "<p>Pick three or four samples across different families, something fresh, something sweet and something woody. Wear each one for a full day and see which one people mention. Then come back for the full bottle of the winner.</p>"
          }
        },
        "faq_7f6h8x": {
          "type": "faq",
          "settings": {
            "question": "Will the fragrance last all day?",
            "answer": "<p>That depends on the concentration and your skin. An Eau de Parfum or Extrait usually carries six to ten hours, an Eau de Toilette lasts less. Spray on moisturized skin at the pulse points and it will hold much longer.</p>"
          }
        },
        "faq_6FjJP4": {
          "type": "faq",
          "settings": {
            "question": "Can I track my order?",
            "answer": "<p>Yes. A tracking link goes to your email as soon as the label is created. If it has not arrived, check your spam folder and then message us and we will resend it.</p>"
          }
        }
      },
